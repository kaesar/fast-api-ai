# --- App ---
APP_BASE_URL=http://localhost:8000
APP_SECRET_KEY=cambia-esto-por-32-caracteres-minimo-dev
APP_HOST=127.0.0.1
APP_PORT=8000

# --- OnMind-XID (facade Entra / OIDC) ---
# XID corre en ../xid con `bun run dev` -> http://localhost:8787
XID_BASE_URL=http://localhost:8787
XID_TENANT_ID=xid
XID_CLIENT_ID=fast-api-ai
# redirect que la app Python usa (debe coincidir con /auth/callback)
# En dev XID deja redirect_uri abierto; en prod hay que fijarlo en XID:
#   XID_REDIRECT_ALLOWLIST=http://localhost:8000/auth/callback,http://localhost:8000/
#   XID_ENV=dev
#   XID_TENANT_ID=xid
XID_REDIRECT_ALLOWLIST=http://localhost:8000/auth/callback,http://localhost:8000/

# --- LLM (Ollama por defecto, compatible OpenAI) ---
# LLM_PROVIDER=ollama | openai
LLM_PROVIDER=ollama

# OpenAI (solo si LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (solo si LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:e4b-mlx
# Ollama acepta cualquier string como key en endpoint compatible OpenAI
OLLAMA_API_KEY=ollama
